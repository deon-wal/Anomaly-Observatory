<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Anomaly Observatory // v4.0</title>
    <style>
        :root { --accent: #00ffd5; --bg: #020610; --panel: #050b17; --danger: #ff3e3e; }
        body { background: var(--bg); color: white; font-family: "Courier New", monospace; margin: 0; overflow: hidden; }
        
        header { padding: 15px 25px; background: #000; border-bottom: 1px solid #1a2a4a; display: flex; justify-content: space-between; align-items: center; }
        .grid { display: grid; grid-template-columns: 1fr 400px; height: calc(100vh - 55px); }
        .side { background: var(--panel); border-left: 1px solid #1a2a4a; overflow-y: auto; padding: 20px; }
        
        .controls { background: rgba(0,0,0,0.3); padding: 15px; border: 1px solid #1a2a4a; margin-bottom: 20px; font-size: 0.75rem; }
        .toggle-group { display: flex; gap: 8px; margin-top: 10px; flex-wrap: wrap; }
        button { background: transparent; border: 1px solid var(--accent); color: var(--accent); padding: 5px 10px; cursor: pointer; font-family: inherit; font-size: 0.7rem; text-transform: uppercase; }
        button.off { border-color: #444; color: #444; }
        button.danger { border-color: var(--danger); color: var(--danger); }

        .event-card { background: rgba(255,255,255,0.03); border-left: 3px solid var(--accent); margin-bottom: 12px; padding: 12px; font-size: 0.8rem; position: relative; }
        .high-threat { border-left-color: var(--danger); background: rgba(255,62,62,0.05); }
        .score-pill { background: var(--accent); color: #000; padding: 1px 5px; font-weight: bold; font-size: 0.65rem; }
        .high-threat .score-pill { background: var(--danger); color: white; }
        .timestamp { color: #555; font-size: 0.65rem; margin-top: 5px; }
        
        canvas { width: 100%; height: 100%; display: block; background: #000; }
        #coords { position: absolute; bottom: 15px; left: 15px; font-size: 0.7rem; color: var(--accent); opacity: 0.6; }
    </style>
</head>
<body>
    <header>
        <div style="letter-spacing:3px"><strong>ANOMALY OBSERVATORY</strong> v4.0</div>
        <div id="status" style="color:var(--accent)">ARCHIVE_LOADED</div>
    </header>

    <div class="grid">
        <div id="viewport" style="position:relative">
            <canvas id="map"></canvas>
            <div id="coords">LAT: 0.000 LON: 0.000</div>
        </div>
        <div class="side">
            <div class="controls">
                <div>SYSTEM_CONTROLS</div>
                <div class="toggle-group">
                    <button id="tog-seismic" onclick="toggleFeed('seismic')">SEISMIC: ON</button>
                    <button id="tog-space" onclick="toggleFeed('space')">SPACE: ON</button>
                    <button class="danger" onclick="purgeArchive()">PURGE ARCHIVE</button>
                </div>
            </div>
            <div id="feed"></div>
        </div>
    </div>

    <script>
        const canvas = document.getElementById("map");
        const ctx = canvas.getContext("2d");
        let events = [];
        let activeFeeds = { seismic: true, space: true };
        let scanLine = 0;

        // --- PERSISTENCE ---
        function saveArchive() {
            localStorage.setItem('obs_history', JSON.stringify(events));
        }

        function loadArchive() {
            const saved = localStorage.getItem('obs_history');
            if (saved) events = JSON.parse(saved);
        }

        function purgeArchive() {
            if(confirm("PERMANENTLY DELETE ARCHIVED TELEMETRY?")) {
                events = [];
                localStorage.removeItem('obs_history');
                renderFeed();
            }
        }

        // --- DATA ENGINE ---
        async function fetchUpdates() {
            try {
                document.getElementById("status").innerText = "UPLINK_ACTIVE...";
                const [qR, sR] = await Promise.all([
                    fetch("https://earthquake.usgs.gov/earthquakes/feed/v1.0/summary/all_hour.geojson"),
                    fetch("https://services.swpc.noaa.gov/json/solar-cycle/observed-solar-cycle-indices.json")
                ]);
                const qJ = await qR.json();
                const sJ = await sR.json();

                let incoming = [];
                
                if (activeFeeds.seismic) {
                    incoming.push(...qJ.features.map(f => ({
                        id: f.id, type: "seismic", title: f.properties.title,
                        ts: f.properties.time, lat: f.geometry.coordinates[1], lon: f.geometry.coordinates[0],
                        text: f.properties.place, source: "USGS", score: Math.min(0.95, (f.properties.mag || 1) / 8)
                    })));
                }

                if (activeFeeds.space) {
                    const latest = sJ[sJ.length - 1];
                    // Generating unique ID based on sunspot number and month
                    const spaceId = `solar-${latest.ss}-${latest.year}-${latest.month}`;
                    incoming.push({
                        id: spaceId, type: "space", title: "Solar Flux Deviation",
                        ts: Date.now(), lat: (Math.random()*140)-70, lon: (Math.random()*300)-150,
                        text: `SSN Index: ${latest.ss}`, source: "NOAA", score: 0.75
                    });
                }

                // Merge and Deduplicate
                const existingIds = new Set(events.map(e => e.id));
                const newStuff = incoming.filter(e => !existingIds.has(e.id));
                
                if (newStuff.length > 0) {
                    events = [...newStuff, ...events].slice(0, 100); // Keep last 100
                    saveArchive();
                }

                renderFeed();
                document.getElementById("status").innerText = "SYSTEM_SYNCED";
            } catch (e) {
                document.getElementById("status").innerText = "LINK_FAILURE";
            }
        }

        function toggleFeed(type) {
            activeFeeds[type] = !activeFeeds[type];
            const btn = document.getElementById(`tog-${type}`);
            btn.className = activeFeeds[type] ? "" : "off";
            btn.innerText = `${type.toUpperCase()}: ${activeFeeds[type] ? 'ON' : 'OFF'}`;
            fetchUpdates();
        }

        function renderFeed() {
            document.getElementById("feed").innerHTML = events
                .sort((a,b) => b.ts - a.ts)
                .map(e => `
                <div class="event-card ${e.score > 0.6 ? 'high-threat' : ''}">
                    <div style="display:flex; justify-content:space-between; margin-bottom:5px">
                        <span class="score-pill">LEVEL: ${(e.score*100).toFixed(0)}</span>
                        <span style="color:#666; font-size:0.6rem">${e.type.toUpperCase()}</span>
                    </div>
                    <strong>${e.title}</strong>
                    <div class="timestamp">${new Date(e.ts).toLocaleString()}</div>
                </div>
            `).join('');
        }

        // --- VISUAL ENGINE ---
        function draw() {
            ctx.fillStyle = "rgba(2, 6, 16, 0.4)";
            ctx.fillRect(0, 0, canvas.width, canvas.height);

            // Tech Grid
            ctx.strokeStyle = "rgba(0, 255, 213, 0.05)";
            ctx.lineWidth = 1;
            for(let i=0; i<canvas.width; i+=canvas.width/20) {
                ctx.beginPath(); ctx.moveTo(i,0); ctx.lineTo(i, canvas.height); ctx.stroke();
            }

            // Radar Scanline
            scanLine = (scanLine + 2.5) % canvas.height;
            ctx.strokeStyle = "rgba(0, 255, 213, 0.15)";
            ctx.beginPath(); ctx.moveTo(0, scanLine); ctx.lineTo(canvas.width, scanLine); ctx.stroke();

            events.forEach(e => {
                const x = (e.lon + 180) * (canvas.width / 360);
                const y = (90 - e.lat) * (canvas.height / 180);
                
                // Visual Fade based on age (approx 1 hour fade)
                const ageFactor = Math.max(0.1, 1 - (Date.now() - e.ts) / 3600000);
                const color = e.score > 0.6 ? `255, 62, 62` : `0, 255, 213`;

                // Outer Pulse
                ctx.beginPath();
                ctx.arc(x, y, 6 + (Math.sin(Date.now()/300)*4), 0, Math.PI*2);
                ctx.strokeStyle = `rgba(${color}, ${ageFactor * 0.4})`;
                ctx.stroke();

                // Blip
                ctx.fillStyle = `rgba(${color}, ${ageFactor})`;
                ctx.fillRect(x-1.5, y-1.5, 3, 3);
            });

            requestAnimationFrame(draw);
        }

        // --- EVENT LISTENERS ---
        canvas.addEventListener('mousemove', (e) => {
            const lon = ((e.offsetX / canvas.width) * 360 - 180).toFixed(3);
            const lat = (90 - (e.offsetY / canvas.height) * 180).toFixed(3);
            document.getElementById("coords").innerText = `LAT: ${lat} LON: ${lon}`;
        });

        window.addEventListener('resize', () => {
            canvas.width = canvas.clientWidth;
            canvas.height = canvas.clientHeight;
        });

        // Initialize
        canvas.width = canvas.clientWidth;
        canvas.height = canvas.clientHeight;
        loadArchive();
        fetchUpdates();
        draw();
        setInterval(fetchUpdates, 60000);
    </script>
</body>
</html>
